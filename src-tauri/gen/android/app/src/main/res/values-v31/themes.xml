<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 12+ always shows a system launch screen with the app icon
         before the webview; it hands over to the animated in-app splash. -->
    <style name="Theme.u_download" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/udl_canvas</item>
        <item name="android:windowSplashScreenBackground">@color/udl_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
</resources>
