{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "U-Download",
  "version": "4.0.0",
  "identifier": "com.udownload.application",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "web/dist",
    "beforeBundleCommand": null
  },
  "app": {
    "windows": [
      {
        "title": "U-Download",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "label": "main",
        "create": false,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/preview/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "app",
      "dmg",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "binaries/**/*"
    ],
    "externalBin": [],
    "copyright": "Copyright \u00a9 2026 U-Download. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Videos, files and torrents, fast",
    "longDescription": "U-Download saves videos from YouTube, TikTok, Instagram and 1000+ sites without watermarks, and fetches files, torrents and magnets over many connections at once.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": "-"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": [],
        "section": "video",
        "priority": "optional"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCQkY1RjkwMTQ3MzQxNjAKUldSZ1FYTVVrRisvTzF3a1BrQUF4djVMYllUNlYxMFIxcG1pc1Z0RS9FWXlXOCsvb1JFeFhrQzIK",
      "endpoints": [
        "https://github.com/DecodeDedan/U-Download/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}