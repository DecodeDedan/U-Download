# Tauri. The app root is this repository (Cargo.toml and tauri.conf.json live here).
/target/
/binaries/
gen/*
# The Android project is hand-edited (share intent, packaging, signing), so it
# is tracked; tauri regenerates only the ignored files inside it.
!gen/android

# Previous layout. Left ignored so a local src-tauri/target cache is not committed.
src-tauri/target
src-tauri/gen/*
!src-tauri/gen/android
src-tauri/binaries/

